---
import { Image } from 'astro:assets';
import Icons from '../components/Icons.astro';
import { site } from '../data/site';
import photo from '../assets/michal.jpg';
import logo from '../assets/mk-logo.png';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  page: 'home' | 'about' | 'resume' | 'case';
}
const { title, description = site.description, page } = Astro.props;
// Which tab is highlighted. Case studies belong to Work.
const active = page === 'home' || page === 'case' ? 'work' : page;
const nav = [
  { key: 'work', href: '/#work', icon: 'i-work', label: 'Work' },
  { key: 'about', href: '/about/', icon: 'i-user', label: 'About me' },
  { key: 'resume', href: '/resume/', icon: 'i-doc', label: 'Resume' },
];
const canonical = new URL(Astro.url.pathname, site.url);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonical} />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonical} />
  <meta property="og:site_name" content={site.name} />
  <meta property="og:image" content={new URL('/og.png', site.url)} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={`${site.name}, ${site.title}`} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:image" content={new URL('/og.png', site.url)} />
  <link rel="icon" href="/favicon.png" type="image/png" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Poppins:wght@400;500;600&display=swap" rel="stylesheet" />
</head>
<body data-page={page}>
  <Icons />
  <a class="skip" href="#content">Skip to content</a>
  <div class="shell">
    <aside class="profile" aria-label="Profile">
      <a class="mk" href="/" aria-label={`${site.name}, home`}><Image src={logo} alt="" width={128} /></a>
      <div class="pcard">
        <Image class="pphoto" src={photo} alt={`Portrait of ${site.name}`} width={148} height={148} densities={[1, 2]} loading="eager" />
        <h2 class="pname">{site.name}</h2>
        <p class="ptitle">{site.titleLines[0]}<br />{site.titleLines[1]}</p>
        <div class="contact-box">
          <a class="crow" href={site.phoneHref} data-contact="phone"><span class="cico"><svg aria-hidden="true"><use href="#i-phone" /></svg></span><span><small>Phone</small><b>{site.phone}</b></span></a>
          <a class="crow" href={`mailto:${site.email}`} data-contact="email"><span class="cico"><svg aria-hidden="true"><use href="#i-mail" /></svg></span><span><small>Email</small><b>{site.email}</b></span></a>
          <div class="crow"><span class="cico"><svg aria-hidden="true"><use href="#i-pin" /></svg></span><span><small>Location</small><b>{site.location}</b></span></div>
        </div>
        <a class="btn btn-grad btn-block" href={site.cv} download><svg aria-hidden="true"><use href="#i-dl" /></svg>Download CV</a>
        {site.linkedin && (
          <div class="psocial">
            <a class="icon-btn" href={site.linkedin} target="_blank" rel="noopener" aria-label="View LinkedIn Profile"><svg aria-hidden="true"><use href="#i-in" /></svg></a>
          </div>
        )}
      </div>
    </aside>

    <div class="main">
      <header class="topbar">
        <a class="mk" href="/" aria-label={`${site.name}, home`}><Image src={logo} alt="" width={104} /></a>
        <nav class="tabs" aria-label="Main">
          {nav.map((n) => (
            <a class:list={['tab', { 'is-active': n.key === active }]} href={n.href} aria-current={n.key === active ? 'page' : undefined}><svg aria-hidden="true"><use href={`#${n.icon}`} /></svg>{n.label}</a>
          ))}
        </nav>
      </header>

      <section class="mob-head" aria-label="Profile">
        <Image src={photo} alt={`Portrait of ${site.name}`} width={88} height={88} densities={[1, 2]} loading="eager" />
        <div class="mh-id">
          <p class="pname" style="font-family:var(--head);font-weight:600;color:var(--ink)">{site.name}</p>
          <p class="ptitle">{site.title}</p>
          <div class="mh-meta">
            <a href={`mailto:${site.email}`} data-contact="email"><svg aria-hidden="true"><use href="#i-mail" /></svg>{site.email}</a>
            <a href={site.phoneHref} data-contact="phone"><svg aria-hidden="true"><use href="#i-phone" /></svg>{site.phone}</a>
            {site.linkedin && <a href={site.linkedin} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-in" /></svg>View LinkedIn Profile</a>}
            <span style="display:inline-flex;align-items:center;gap:6px"><svg aria-hidden="true"><use href="#i-pin" /></svg>{site.location}</span>
          </div>
        </div>
        <div class="mh-cta">
          <a class="btn btn-grad" href={site.cv} download><svg aria-hidden="true"><use href="#i-dl" /></svg>Download CV</a>
          <a class="btn btn-ghost" href={`mailto:${site.email}`} data-contact="email"><svg aria-hidden="true"><use href="#i-mail" /></svg>Contact me</a>
        </div>
      </section>

      <slot />

      <footer class="footer"><p>© {new Date().getFullYear()} {site.name}</p></footer>
    </div>
  </div>

  <dialog class="lightbox" id="lightbox" aria-label="Full screen image">
    <button class="lb-close" type="button" aria-label="Close">×</button>
    <div class="lb-scroll"><img alt="" /></div>
  </dialog>

  <dialog class="contact-dlg" id="contact" aria-labelledby="contact-h">
    <button class="lb-close" type="button" aria-label="Close">×</button>
    <h2 id="contact-h">Get in touch</h2>
    <div class="cd-group">
      <p class="cd-label">Email</p>
      <p class="cd-value">{site.email}</p>
      <div class="cd-actions">
        <a class="btn btn-grad" href={`https://mail.google.com/mail/?view=cm&fs=1&to=${site.email}`} target="_blank" rel="noopener">Gmail</a>
        <a class="btn btn-ghost" href={`https://outlook.office.com/mail/deeplink/compose?to=${site.email}`} target="_blank" rel="noopener">Outlook</a>
      </div>
    </div>
    <div class="cd-group">
      <p class="cd-label">Phone</p>
      <p class="cd-value">{site.phone}</p>
      <div class="cd-actions">
        <a class="btn btn-ghost" href={site.phoneHref}>Call</a>
        <a class="btn btn-ghost" href={site.whatsapp} target="_blank" rel="noopener">WhatsApp</a>
      </div>
    </div>
    {site.linkedin && (
      <div class="cd-group">
        <p class="cd-label">LinkedIn</p>
        <div class="cd-actions"><a class="btn btn-ghost" href={site.linkedin} target="_blank" rel="noopener"><svg aria-hidden="true"><use href="#i-in" /></svg>View profile</a></div>
      </div>
    )}
  </dialog>

  <script>
    const d = document;
    d.documentElement.classList.add('js');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Reveal on scroll
    const rev = d.querySelectorAll('.reveal');
    if (!('IntersectionObserver' in window) || reduce) rev.forEach((e) => e.classList.add('in'));
    else {
      const io = new IntersectionObserver(
        (es) => es.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } }),
        { rootMargin: '0px 0px -6% 0px' },
      );
      rev.forEach((e) => io.observe(e));
    }

    // Portfolio filters
    const chips = d.querySelectorAll<HTMLButtonElement>('.chip');
    const cards = d.querySelectorAll<HTMLElement>('.wcard');
    const count = d.getElementById('count');
    chips.forEach((c) =>
      c.addEventListener('click', () => {
        const f = c.dataset.f;
        let n = 0;
        chips.forEach((o) => o.setAttribute('aria-pressed', String(o === c)));
        cards.forEach((k) => {
          const show = f === 'all' || k.dataset.cat === f;
          k.hidden = !show;
          if (show) { n++; k.classList.add('in'); }
        });
        if (count) count.textContent = `${n} projects shown`;
      }),
    );

    // Videos and interactive pieces: load the third-party player only when clicked
    d.querySelectorAll<HTMLButtonElement>('[data-embed]').forEach((b) =>
      b.addEventListener('click', () => {
        const f = d.createElement('iframe');
        f.src = b.dataset.embed!;
        f.title = b.getAttribute('aria-label') || 'Embedded media';
        f.allow = 'autoplay; encrypted-media; picture-in-picture; fullscreen; clipboard-write';
        f.allowFullscreen = true;
        f.setAttribute('scrolling', 'no');
        b.closest('.frame')?.replaceChildren(f);
      }),
    );

    // Contact panel: mailto alone fails silently without a mail app or inside WhatsApp/Teams/LinkedIn browsers,
    // so email links open a panel with options that always work. Phone links only do this on desktop.
    const cd = d.getElementById('contact') as HTMLDialogElement | null;
    if (cd && typeof cd.showModal === 'function') {
      const desktop = matchMedia('(hover: hover) and (pointer: fine)');
      d.querySelectorAll<HTMLAnchorElement>('[data-contact]').forEach((a) =>
        a.addEventListener('click', (e) => {
          if (a.dataset.contact === 'phone' && !desktop.matches) return;
          e.preventDefault();
          cd.showModal();
        }),
      );
      cd.querySelector('.lb-close')!.addEventListener('click', () => cd.close());
      cd.addEventListener('click', (e) => { if (e.target === cd) cd.close(); });
    }

    // Full-screen image viewer
    const lb = d.getElementById('lightbox') as HTMLDialogElement | null;
    if (lb && typeof lb.showModal === 'function') {
      const img = lb.querySelector('img')!;
      d.querySelectorAll<HTMLAnchorElement>('a[data-lightbox]').forEach((a) =>
        a.addEventListener('click', (e) => {
          e.preventDefault();
          img.src = a.href;
          img.alt = a.dataset.alt || '';
          lb.querySelector('.lb-scroll')!.scrollTop = 0;
          lb.showModal();
        }),
      );
      lb.querySelector('.lb-close')!.addEventListener('click', () => lb.close());
      lb.addEventListener('click', (e) => { if (e.target === lb) lb.close(); });
    }
  </script>
</body>
</html>
