---
import Base from '../layouts/Base.astro';
import { site, experience, education, tools, languages } from '../data/site';
---
<Base title={`Resume | ${site.name}`} description="Michal Kleinboim's experience, education, tools and languages in Learning & Development and instructional design." page="resume">
  <main id="content">
    <section class="panel" id="resume" aria-labelledby="resume-h">
      <h1 class="title" id="resume-h">Resume</h1>
      <h3 class="sub" style="margin-top:28px"><svg aria-hidden="true"><use href="#i-work" /></svg>Experience</h3>
      <ol class="timeline">
        {experience.map((e) => (
          <li class="tl"><div class="tl-card">
            <time>{e.when}</time><h3>{e.role}</h3><p>{e.org}</p>
            {e.points.length > 0 && <ul>{e.points.map((pt) => <li>{pt}</li>)}</ul>}
          </div></li>
        ))}
      </ol>

      <h3 class="sub"><svg aria-hidden="true"><use href="#i-cap" /></svg>Education</h3>
      <ol class="timeline">
        {education.map((e) => (
          <li class="tl"><div class="tl-card">
            <time>{e.when}</time><h3>{e.role}</h3><p>{e.org}</p>
            {e.note && <p class="note">{e.note}</p>}
          </div></li>
        ))}
      </ol>

      <div class="res-cols">
        <div>
          <h3 class="sub"><svg aria-hidden="true"><use href="#i-tool" /></svg>Tools</h3>
          <ul class="tools">{tools.map((t) => <li>{t}</li>)}</ul>
        </div>
        <div>
          <h3 class="sub">Languages</h3>
          <ul class="langs">{languages.map((l) => <li><b>{l.name}</b><span>{l.level}</span></li>)}</ul>
        </div>
      </div>

      <div class="res-cta">
        <p>Want the full picture?</p>
        <a class="btn btn-grad" href={site.cv} download><svg aria-hidden="true"><use href="#i-dl" /></svg>Download CV</a>
      </div>
    </section>
  </main>
</Base>
